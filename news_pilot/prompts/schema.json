{
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["news_id", "event_type", "direction", "magnitude", "is_expected",
                     "affected_tickers", "affected_sectors", "scope", "confidence", "rationale"],
        "properties": {
          "news_id": {"type": "integer"},
          "event_type": {"type": "string",
                         "enum": ["earnings", "guidance", "m_and_a", "regulation", "macro_rate",
                                  "geopolitics", "supply_chain", "product", "legal", "other"]},
          "direction": {"type": "string", "enum": ["positive", "negative", "neutral", "mixed"]},
          "magnitude": {"type": "integer", "minimum": 1, "maximum": 5},
          "is_expected": {"type": "boolean"},
          "affected_tickers": {"type": "array", "items": {"type": "string"}},
          "affected_sectors": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "string", "enum": ["GLOBAL", "US", "TW"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
