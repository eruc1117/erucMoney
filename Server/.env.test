# 測試專用環境（jest.config.js 的 setupFiles 以 override 載入，優先於根目錄 .env）
# DB_NAME 必須以 _test 結尾，tests/setup-env.js 會檢查，避免對正式庫 Stock 跑測試。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Stock_test
DB_USER=postgres
# DB_PASSWORD 不放在這裡：從根目錄 .env 讀（本機），CI 由 workflow 的 env 給
JWT_SECRET=test-secret-test-secret-test-secret-0123456789abcdef
JWT_TTL=1h
ADMIN_PASSWORD=TestAdmin123!
ALLOWED_ORIGINS=http://allowed.test
RATE_LIMIT_PER_MIN=60
# 留空：本地登入不問行事曆；要測 SSO 的案例會在測試裡暫時設成 nock 的假位址
AUTH_API_URL=
FINMIND_TOKEN=
