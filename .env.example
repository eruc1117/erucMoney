# 複製成 .env（repo 根目錄；已在 .gitignore）。Node（Server/）與 Python（Crawler/、LSTM/、NewsModels/）都讀這一份。
# 任何密碼、金鑰只放這裡，不要寫進程式或文件。

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Stock
DB_USER=postgres
DB_PASSWORD=

# ── FinMind（選填；有 token 額度 600 次/小時）──
FINMIND_TOKEN=

# ── Node API（Server/）──
# 前端來源白名單（逗號分隔）。沒設就全開——只適合本機開發。
ALLOWED_ORIGINS=https://erucmoney.com,https://www.erucmoney.com,http://localhost:5173
# JWT 簽章密鑰（至少 32 字元）。沒設就用 Server/.jwt_secret 自動產生的那一把。
# 產生：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 單一登入：這個值必須等於行事曆平台 meeting_API_Server 的 SECRET，兩邊才能互認 token。
JWT_SECRET=
# 單一登入：行事曆平台 API 位址。設了之後 /auth/login 會先拿帳密去那邊登入（本地 admin 帳號仍可登入）。
AUTH_API_URL=http://localhost:5000
# 第一次啟動時 admin 的密碼（只在 users.admin 尚未設密碼時生效）。之後改密碼走前端「帳號」頁。
ADMIN_PASSWORD=
# 每個來源 IP 每分鐘的請求上限（對外之後建議 300；本機可留空）
RATE_LIMIT_PER_MIN=300
